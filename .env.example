ORBIT_APP_NAME=Orbit

# Shared URLs
ORBIT_WEB_URL=http://localhost:3000
ORBIT_API_URL=http://localhost:3001

# Optional server-side proxy override for the web app.
# Set automatically in Docker so the web container talks to the api container.
# ORBIT_API_INTERNAL_URL=http://api:3001

# API runtime
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
DATABASE_SSL=false
ORBIT_CONFIG_MODE=memory

# Optional when web/api live on sibling subdomains like app.example.com + api.example.com
ORBIT_COOKIE_DOMAIN=

# Optional passkey overrides. Defaults come from ORBIT_WEB_URL and ORBIT_APP_NAME.
# PASSKEY_RP_ID=
# PASSKEY_RP_NAME=
# PASSKEY_ORIGIN=

# Optional email integration
RESEND_API_KEY=

# Optional Vercel Edge Config integration for the API
# ORBIT_CONFIG_MODE=edge
# ORBIT_VERCEL_EDGE_CONFIG=
# ORBIT_VERCEL_EDGE_CONFIG_STORE_ID=
# ORBIT_VERCEL_API_TOKEN=
# ORBIT_VERCEL_EDGE_CONFIG_ITEM_KEY=instance-config

# Optional Cloudflare R2 workspace storage
ORBIT_R2_ACCOUNT_ID=
ORBIT_R2_ACCESS_KEY_ID=
ORBIT_R2_SECRET_ACCESS_KEY=
ORBIT_R2_BUCKET=
ORBIT_R2_PUBLIC_URL=

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
CFX_CLIENT_ID=
CFX_CLIENT_SECRET=
CFX_DISCOVERY_URL=
CFX_ISSUER=
CFX_AUTHORIZATION_URL=
CFX_TOKEN_URL=
CFX_USERINFO_URL=
CFX_SCOPES=openid,profile,email

# Optional Dragonfly (Redis-compatible) for workspace rate limiting
# DRAGONFLY_URL=redis://localhost:6379

# Docker Compose self-hosting only
POSTGRES_PASSWORD=change-me
# ORBIT_WEB_IMAGE=ghcr.io/projectkura/orbit-web:latest
# ORBIT_API_IMAGE=ghcr.io/projectkura/orbit-api:latest
