    "@orbit/shared": "workspace:*",
    "@types/mdx": "^2.0.13",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^3.101.0"
  }
}
