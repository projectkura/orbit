{
  "name": "@orbit/web",
  "version": "0.0.10",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "build:cf": "vite build",
    "deploy": "wrangler deploy --config .output/server/wrangler.json",
